# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
.venv/
venv/
ENV/
env/

# IDE and Editor settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Large datasets (Keep folder with .gitkeep and lightweight samples)
data/*.csv
!data/.gitkeep
!data/samples_for_gui.csv

# Models (optional to ignore or track - comment out if you want git LFS)
# models/*.pkl

# Results and figures generated automatically
# results/*.png

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
